{
  "name": "floo-productivity-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack -p 3000",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start -p 3000",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "test:integration": "node node_modules/tsx/dist/cli.mjs scripts/test-integration.ts",
    "supabase:start": "node node_modules/supabase/dist/supabase.js start",
    "supabase:stop": "node node_modules/supabase/dist/supabase.js stop",
    "db:reset": "node node_modules/supabase/dist/supabase.js db reset",
    "configure:local": "node scripts/configure-local.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "luxon": "3.7.2",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
